{
  "name": "codesync",
  "version": "2.0.0",
  "description": "CodeSync - simplified Git operations plus an AI code assistant",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli",
    "desktop"
  ],
  "scripts": {
    "install:cli": "cd cli && npm install",
    "install:desktop": "cd desktop && npm install",
    "link:cli": "cd cli && npm link",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:start": "cd desktop && npm start",
    "test": "node run-tests.js"
  },
  "keywords": [
    "git",
    "ai",
    "code",
    "upload",
    "download",
    "annotate"
  ],
  "author": "",
  "license": "MIT"
}